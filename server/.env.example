PORT=4000
MONGODB_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/mini-cicd
CLIENT_URL=http://localhost:5174
# Required to access /api/builds. Use a long, random local value.
API_AUTH_TOKEN=replace_with_a_long_random_token
# Webhook verification is enabled by default. Set a GitHub webhook secret.
GITHUB_SECRET=replace_with_a_long_random_webhook_secret
WEBHOOK_VERIFICATION_ENABLED=true
# Comma-separated repositories that this runner is allowed to execute.
ALLOWED_REPOS=your-github-user/your-repository
MAX_CONCURRENT_BUILDS=2
STEP_TIMEOUT_MS=300000
PIPELINE_TIMEOUT_MS=1200000
BUILDS_DIR=.tmp/cicd-builds
# Optional local Git base URL for controlled development/test fixtures.
# GIT_BASE_URL=https://github.com
# Optional SSH deployment. Host key checking remains enabled.
DEPLOY_HOST=your-vps-ip
DEPLOY_USER=ubuntu
DEPLOY_PATH=/var/www/app
DEPLOY_KEY_PATH=/home/you/.ssh/id_rsa
DEPLOY_KNOWN_HOSTS_PATH=/home/you/.ssh/known_hosts
